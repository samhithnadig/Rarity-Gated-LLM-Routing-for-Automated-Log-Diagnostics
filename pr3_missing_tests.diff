+def strip_punctuation(text: str) -> str:
+    """Remove common punctuation characters from text.
+
+    Args:
+        text: The input string.
+
+    Returns:
+        The string with punctuation removed.
+    """
+    return "".join(c for c in text if c.isalnum() or c.isspace())
